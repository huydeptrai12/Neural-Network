#!/usr/bin/env python3
# nn/bin/nn
# Standard library imports
import shutil
import glob
import sys
import os

# Local application/library specific imports
import nn
import nn_train


origin_nn = os.path.dirname(nn.__file__)
origin_nn_train = os.path.dirname(nn_train.__file__)

target_root = os.path.join(os.getcwd(), 'nn')

target_nn = os.path.join(target_root, 'nn')
target_nn_train = os.path.join(target_root, 'nn_train')

if os.path.exists(target_root):
    print('Target path %s already exists.' % (target_nn_train))
    sys.exit()

os.mkdir(target_root)

shutil.copytree(origin_nn, target_nn)
shutil.copytree(origin_nn_train, target_nn_train)

print("Copy nn from %s to %s" % (origin_nn, target_nn))
print("Copy nn_train from %s to %s" % (origin_nn_train, target_nn_train))
